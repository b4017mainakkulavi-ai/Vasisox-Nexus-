rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Multi-device synchronized application state
      match /syncState/{stateId} {
        allow read, write: if isOwner(userId) && isValidId(stateId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId) && isValidId(taskId);
      }

      // Subjects subcollection
      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId) && isValidId(subjectId);
      }

      // Schedule subcollection
      match /schedule/{scheduleId} {
        allow read, write: if isOwner(userId) && isValidId(scheduleId);
      }

      // Revisions subcollection
      match /revisions/{revisionId} {
        allow read, write: if isOwner(userId) && isValidId(revisionId);
      }

      // Exams subcollection
      match /exams/{examId} {
        allow read, write: if isOwner(userId) && isValidId(examId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
